local H = require("../harness/Harness")
local S = require("../support")

local describe, it, expect, beforeEach, afterEach = H.describe, H.it, H.expect, H.beforeEach, H.afterEach

describe("StealService", function()
	local world, services, fake, GameConfig, Steal, Keys, steal

	beforeEach(function()
		world = H.newWorld({ Time = 1700000000 })
		GameConfig = world:require("ReplicatedStorage.Config.GameConfig")
		Steal = world:require("ReplicatedStorage.Rules.Steal")
		Keys = world:require("ReplicatedStorage.Config.Keys")
		steal = GameConfig.Steal
		local plots: { [any]: any } = {}
		fake = { Name = "PlotService", Plots = plots }
		function fake.GetPlot(_self, player: any)
			return if plots[player] then {} else nil
		end
		function fake.GetCaps(_self, player: any)
			return if plots[player] then plots[player].Caps else nil
		end
		function fake.GetBase(_self, player: any)
			return if plots[player] then plots[player].Base else nil
		end
		fake.LockChanged = world:require("ReplicatedStorage.Packages.Signal").new()
		fake.LockedUntil = {}
		function fake.GetLockedUntil(_self, player: any)
			return fake.LockedUntil[player] or 0
		end
		function fake.IsLocked(_self, player: any)
			return (fake.LockedUntil[player] or 0) > world.now
		end
		function fake.Assign(player: any, x: number)
			local caps = {}
			for slot = 1, GameConfig.BoardSlots do
				caps[slot] = world:newPart(`Slot{slot}`, x + slot, 1, 10)
			end
			plots[player] = { Base = world:newPart("Base", x, 0, 0), Caps = caps }
		end
		services = world:boot({ "KeyboardService", "StealService" }, { PlotService = fake })
	end)

	afterEach(function()
		expect(world.errors):toEqual({})
		world:destroy()
	end)

	local function join(name: string, x: number, overrides: any?)
		local data: any = { PlaySeconds = 5000, Board = S.board("GlassTink", "PlainClack") }
		for key, value in overrides or {} do
			data[key] = value
		end
		local player, loaded = world:join({ Name = name }, data, false)
		fake.Assign(player, x)
		world.Data.Service.PlayerLoaded:Fire(player, loaded)
		return player, loaded
	end

	local function prompt(owner: any, slot: number): any
		return fake.Plots[owner].Caps[slot]:FindFirstChild("StealPrompt")
	end

	local function attempt(thief: any, owner: any, slot: number)
		local p = prompt(owner, slot)
		p.PromptButtonHoldBegan:Fire(thief)
		p.Triggered:Fire(thief)
		p.PromptButtonHoldEnded:Fire(thief)
	end

	local function alertsTo(player: any, phase: number): { any }
		local out = {}
		for _, entry in world:firedOf("StealAlert") do
			if entry.Target == player and entry.Args[3] == phase then
				table.insert(out, entry.Args)
			end
		end
		return out
	end

	local function setup(victimOverrides: any?, thiefOverrides: any?)
		local thiefSetup: any = { Board = S.board("OfficeTap") }
		for key, value in thiefOverrides or {} do
			thiefSetup[key] = value
		end
		local victim, victimData = join("Vic", 0, victimOverrides)
		local thief, thiefData = join("Bob", 200, thiefSetup)
		world:spawnCharacter(victim, 0, 3, 0)
		world:spawnCharacter(thief, 1, 3, 10)
		return victim, victimData, thief, thiefData
	end

	local function deliver(thief: any)
		world:moveCharacter(thief, 200, 3, 0)
		world:advance(0.2)
	end

	local function boardCount(data: any): number
		local count = 0
		for index = 1, GameConfig.BoardSlots do
			if data.Board[index] ~= "" then
				count += 1
			end
		end
		return count
	end

	describe("prompts", function()
		it("creates prompts only on occupied caps", function()
			local victim = setup()
			expect(prompt(victim, 1) ~= nil):toBe(true)
			expect(prompt(victim, 2) ~= nil):toBe(true)
			expect(prompt(victim, 3)):toBeNil()
			expect(prompt(victim, 11)):toBeNil()
		end)

		it("describes the key and the owner", function()
			local victim = setup()
			local p = prompt(victim, 1)
			expect(p.ActionText):toBe("Steal!")
			expect(p.ObjectText):toBe("Glass Tink")
			expect(p.MaxActivationDistance):toBe(steal.PromptRange)
			expect(p.RequiresLineOfSight):toBe(false)
			expect(p:GetAttribute("OwnerUserId")):toBe(victim.UserId)
		end)

		it("holds longer for rarer keys and doubles while the lesson is pending", function()
			local victim, data = setup({ Board = S.board("GlassTink", "PlainClack") })
			expect(prompt(victim, 1).HoldDuration):toBe(Steal.HoldSeconds(3, true))
			expect(prompt(victim, 2).HoldDuration):toBe(Steal.HoldSeconds(1, true))
			expect(Steal.HoldSeconds(3, true)):toBe(Steal.HoldSeconds(3, false) * 2)
			expect(data.TheftLessonDone):toBe(false)
		end)

		it("uses the normal hold once the lesson is done", function()
			local victim = setup({ TheftLessonDone = true })
			expect(prompt(victim, 1).HoldDuration):toBe(Steal.HoldSeconds(3, false))
		end)

		it("removes the prompt when the slot is cleared and adds one when a key is placed", function()
			local victim, data = setup()
			expect(world:invoke("ClearSlot", victim, 2)):toBe(true)
			expect(prompt(victim, 2)):toBeNil()
			expect(world:invoke("PlaceKey", victim, 5, "PlainClack")):toBe(true)
			expect(prompt(victim, 5) ~= nil):toBe(true)
			expect(data.Board[5]):toBe("PlainClack")
		end)

		it("updates the prompt when the key in a slot changes", function()
			local victim = setup({ Inventory = { TopazTap = 1 }, TheftLessonDone = true })
			world:invoke("PlaceKey", victim, 2, "TopazTap")
			expect(prompt(victim, 2).ObjectText):toBe("Topaz Tap")
			expect(prompt(victim, 2).HoldDuration):toBe(Steal.HoldSeconds(3, false))
		end)

		it("reuses the same prompt instance across board renders", function()
			local victim = setup()
			local before = prompt(victim, 1)
			services.KeyboardService.BoardChanged:Fire(victim)
			expect(prompt(victim, 1) == before):toBe(true)
		end)

		it("removes all prompts when the owner leaves", function()
			local victim = setup()
			local cap = fake.Plots[victim].Caps[1]
			world:removePlayer(victim)
			expect(cap:FindFirstChild("StealPrompt")):toBeNil()
		end)
	end)

	describe("starting a steal", function()
		it("alerts the victim when a hold begins", function()
			local victim, _, thief = setup()
			prompt(victim, 1).PromptButtonHoldBegan:Fire(thief)
			local alerts = alertsTo(victim, 1)
			expect(#alerts):toBe(1)
			expect(alerts[1][1]):toBe("Bob")
			expect(alerts[1][2]):toBe(Keys.ById.GlassTink.Index)
		end)

		it("does not alert the victim for a hold that is not allowed", function()
			local victim, _, thief = setup({ PlaySeconds = 10 })
			prompt(victim, 1).PromptButtonHoldBegan:Fire(thief)
			expect(#alertsTo(victim, 1)):toBe(0)
		end)

		it("does nothing when the hold is released early", function()
			local victim, data, thief = setup()
			local p = prompt(victim, 1)
			p.PromptButtonHoldBegan:Fire(thief)
			p.PromptButtonHoldEnded:Fire(thief)
			expect(data.Board[1]):toBe("GlassTink")
			expect(#alertsTo(victim, 2)):toBe(0)
		end)
	end)

	describe("rejections", function()
		it("lets a thief know why with a phase 9 alert", function()
			local victim, data, thief = setup({ PlaySeconds = 10 })
			attempt(thief, victim, 1)
			local rejected = alertsTo(thief, 9)
			expect(#rejected):toBe(1)
			expect(rejected[1][1]):toBe("They're protected by a new-player shield!")
			expect(rejected[1][2]):toBe(0)
			expect(data.Board[1]):toBe("GlassTink")
		end)

		it("shields victims until they have played long enough", function()
			local victim, data, thief = setup({ PlaySeconds = steal.ShieldPlaySeconds - 5 })
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("GlassTink")
			world:advance(10)
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("")
		end)

		it("cannot steal your own key", function()
			local victim, data = setup()
			attempt(victim, victim, 1)
			expect(data.Board[1]):toBe("GlassTink")
			expect(alertsTo(victim, 9)[1][1]):toBe(Steal.Reasons.Self)
		end)

		it("cannot steal while carrying keyfall caps", function()
			local victim, data, thief = setup()
			local carrying = true
			world.registry.KeyfallService = {
				IsCarrying = function(_self: any, player: any)
					return carrying and player == thief
				end,
			}
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("GlassTink")
			expect(alertsTo(thief, 9)[1][1]):toBe("You're already carrying a key!")
			carrying = false
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("")
		end)

		it("cannot steal while already carrying", function()
			local victim, data, thief = setup()
			attempt(thief, victim, 1)
				attempt(thief, victim, 2)
			expect(data.Board[2]):toBe("PlainClack")
			expect(alertsTo(thief, 9)[1][1]):toBe("You're already carrying a key!")
		end)

		it("blocks thieves far stronger than the victim", function()
			local victim, data, thief = setup(nil, { Board = S.board("ThunderKey") })
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("GlassTink")
			expect(alertsTo(thief, 9)[1][1]):toBe("They're too weak to rob!")
		end)

		it("blocks thieves who are too far from the cap", function()
			local victim, data, thief = setup()
			world:moveCharacter(thief, 60, 3, 10)
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("GlassTink")
			expect(alertsTo(thief, 9)[1][1]):toBe(Steal.Reasons.TooFar)
		end)

		it("rejects a steal when the key changed during the hold", function()
			local victim, data, thief = setup({ Inventory = { TopazTap = 1 } })
			local p = prompt(victim, 1)
			p.PromptButtonHoldBegan:Fire(thief)
			world:invoke("PlaceKey", victim, 1, "TopazTap")
			p.Triggered:Fire(thief)
			expect(data.Board[1]):toBe("TopazTap")
			expect(alertsTo(thief, 9)[1][1]):toBe(Steal.Reasons.Gone)
		end)

		it("needs a character near the cap", function()
			local victim, data, thief = setup()
			world:resetCharacter(thief)
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("GlassTink")
		end)
	end)

	describe("carrying", function()
		it("takes the key off the victim board and burdens the thief", function()
			local victim, data, thief = setup()
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("")
			expect(data.BoardTags[1]):toBe("")
			expect(prompt(victim, 1)):toBeNil()
			expect(thief.Character:GetAttribute("CarryingKey")):toBe("GlassTink")
			expect(thief.Character:GetAttribute("StolenFromUserId")):toBe(victim.UserId)
			expect(world:walkSpeed(thief)):toBe(steal.CarryWalkSpeed)
			expect(thief.Character:FindFirstChild("StolenKey") ~= nil):toBe(true)
			expect(thief.Character.StolenKey.CanCollide):toBe(false)
			expect(thief.Character.StolenKey.Massless):toBe(true)
		end)

		it("tells the victim to chase", function()
			local victim, _, thief = setup()
			attempt(thief, victim, 1)
			local alerts = alertsTo(victim, 2)
			expect(#alerts):toBe(1)
			expect(alerts[1][1]):toBe("Bob")
			expect(alerts[1][2]):toBe(Keys.ById.GlassTink.Index)
		end)

		it("settles victim income at the pre-theft rate before removing the key", function()
			local victim, data, thief = setup({ Board = S.board("GlassTink"), Cash = 0 })
			world:advance(100)
			attempt(thief, victim, 1)
			expect(data.Cash):toBe(Keys.GetIncome("GlassTink") * 100)
			expect(data.IncomeAt):toBe(math.floor(world.now))
			world:advance(50)
			services.KeyboardService:Settle(victim)
			expect(data.Cash):toBe(Keys.GetIncome("GlassTink") * 100)
		end)
	end)

	describe("delivery", function()
		it("conserves keys and tags the stolen key", function()
			local victim, victimData, thief, thiefData = setup()
			local before = boardCount(victimData)
			attempt(thief, victim, 1)
			deliver(thief)
			expect(boardCount(victimData)):toBe(before - 1)
			expect(S.totals(thiefData).GlassTink):toBe(1)
			local slot = table.find(thiefData.Board, "GlassTink")
			expect(slot ~= nil):toBe(true)
			expect(thiefData.BoardTags[slot]):toBe("@Vic")
			expect(victimData.Board[1]):toBe("")
		end)

		it("announces the theft, teaches the victim and alerts them", function()
			local victim, victimData, thief = setup()
			attempt(thief, victim, 1)
			deliver(thief)
			local feed = world:firedOf("StealFeed")
			expect(#feed):toBe(1)
			expect(feed[1].Target):toBe("All")
			expect(feed[1].Args[1]):toBe("Bob")
			expect(feed[1].Args[2]):toBe("Vic")
			expect(feed[1].Args[3]):toBe(Keys.ById.GlassTink.Index)
			expect(victimData.TheftLessonDone):toBe(true)
			expect(#alertsTo(victim, 4)):toBe(1)
		end)

		it("frees the thief of the burden", function()
			local victim, _, thief = setup()
			attempt(thief, victim, 1)
			deliver(thief)
			expect(world:walkSpeed(thief)):toBe(steal.NormalWalkSpeed)
			expect(thief.Character:GetAttribute("CarryingKey")):toBeNil()
			expect(thief.Character:FindFirstChild("StolenKey")):toBeNil()
		end)

		it("does not deliver until the thief reaches their base", function()
			local victim, _, thief, thiefData = setup()
			attempt(thief, victim, 1)
			world:moveCharacter(thief, 200 + steal.DeliverRadius + 10, 3, 0)
			world:advance(0.4)
			expect(S.totals(thiefData).GlassTink):toBeNil()
			expect(thief.Character:GetAttribute("CarryingKey")):toBe("GlassTink")
		end)

		it("sends the key to the inventory when auto place is off", function()
			local victim, _, thief, thiefData = setup(nil, { Settings = { AutoPlace = false } })
			attempt(thief, victim, 1)
			deliver(thief)
			expect(thiefData.Inventory.GlassTink):toBe(1)
		end)

		it("locks the victim base afterwards for the lock duration", function()
			local victim, victimData, thief = setup()
			local second = join("Cat", 400, { Board = S.board("OfficeTap") })
			world:spawnCharacter(second, 2, 3, 10)
			attempt(thief, victim, 1)
			deliver(thief)
			attempt(second, victim, 2)
			expect(victimData.Board[2]):toBe("PlainClack")
			expect(alertsTo(second, 9)[1][1]):toBe("Their base is locked!")
			world:advance(steal.BaseLockSeconds + 1)
			world:moveCharacter(second, 2, 3, 10)
			attempt(second, victim, 2)
			expect(victimData.Board[2]):toBe("")
		end)

		it("sends the key home when the victim leaves mid carry", function()
			local victim, victimData, thief, thiefData = setup()
			local before = S.totals(victimData).GlassTink
			attempt(thief, victim, 1)
			expect(victimData.Board[1]):toBe("")
			world:removePlayer(victim)
			expect(victimData.Board[1]):toBe("GlassTink")
			expect(victimData.BoardTags[1]):toBe("")
			expect(S.totals(victimData).GlassTink):toBe(before)
			expect(world:walkSpeed(thief)):toBe(steal.NormalWalkSpeed)
			expect(thief.Character:FindFirstChild("StolenKey")):toBeNil()
			expect(thief.Character:GetAttribute("CarryingKey")):toBeNil()
			expect(thief.Character:GetAttribute("StolenFromUserId")):toBeNil()
			local toasts = alertsTo(thief, 9)
			expect(#toasts):toBe(1)
			expect(toasts[1][1]):toBe("They left — the key went home!")
			deliver(thief)
			expect(S.totals(thiefData).GlassTink):toBeNil()
			expect(#world:firedOf("StealFeed")):toBe(0)
			expect(S.totals(victimData).GlassTink):toBe(before)
		end)

		it("sends the key to the inventory when the victim leaves and the slot was refilled", function()
			local victim, victimData, thief, thiefData = setup({ Inventory = { PlainClack = 1 } })
			attempt(thief, victim, 1)
			world:invoke("PlaceKey", victim, 1, "PlainClack")
			world:removePlayer(victim)
			expect(victimData.Board[1]):toBe("PlainClack")
			expect(victimData.Inventory.GlassTink):toBe(1)
			deliver(thief)
			expect(S.totals(thiefData).GlassTink):toBeNil()
		end)
	end)

	describe("tagging", function()
		it("returns the key to its original slot", function()
			local victim, data, thief = setup()
			attempt(thief, victim, 1)
			world:moveCharacter(victim, 3, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(true)
			expect(data.Board[1]):toBe("GlassTink")
			expect(data.BoardTags[1]):toBe("")
			expect(prompt(victim, 1) ~= nil):toBe(true)
			expect(world:walkSpeed(thief)):toBe(steal.NormalWalkSpeed)
			expect(thief.Character:FindFirstChild("StolenKey")):toBeNil()
			expect(thief.Character:GetAttribute("CarryingKey")):toBeNil()
			expect(#alertsTo(victim, 3)):toBe(1)
		end)

		it("does not let a returned thief deliver", function()
			local victim, _, thief, thiefData = setup()
			attempt(thief, victim, 1)
			world:moveCharacter(victim, 3, 3, 10)
			world:invoke("TagThief", victim, thief.UserId)
			deliver(thief)
			expect(S.totals(thiefData).GlassTink):toBeNil()
			expect(#world:firedOf("StealFeed")):toBe(0)
		end)

		it("fails from out of range", function()
			local victim, data, thief = setup({ TheftLessonDone = true })
			attempt(thief, victim, 1)
			world:moveCharacter(victim, 1 + steal.TagRange + 5, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(false)
			expect(data.Board[1]):toBe("")
		end)

		it("fails for anyone but the victim", function()
			local victim, data, thief = setup()
			local bystander = join("Dan", 400)
			world:spawnCharacter(bystander, 2, 3, 10)
			attempt(thief, victim, 1)
			expect(world:invoke("TagThief", bystander, thief.UserId)):toBe(false)
			expect(world:invoke("TagThief", thief, thief.UserId)):toBe(false)
			expect(data.Board[1]):toBe("")
		end)

		it("fails when the target is not carrying", function()
			local victim, _, thief = setup()
			world:moveCharacter(victim, 3, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(false)
			expect(world:invoke("TagThief", victim, 123456)):toBe(false)
		end)

		it("enforces a per caller cooldown", function()
			local victim, data, thief = setup({ TheftLessonDone = true })
			attempt(thief, victim, 1)
			world:moveCharacter(victim, 1 + steal.TagRange + 5, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(false)
			world:moveCharacter(victim, 3, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(false)
			expect(data.Board[1]):toBe("")
			world:advance(steal.TagCooldown + 0.1)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(true)
			expect(data.Board[1]):toBe("GlassTink")
		end)

		it("reaches further while the victim has not had the lesson", function()
			local victim, data, thief = setup({ TheftLessonDone = false })
			attempt(thief, victim, 1)
			local gap = (steal.TagRange + steal.LessonTagRange) / 2
			world:moveCharacter(victim, 1 + gap, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(true)
			expect(data.Board[1]):toBe("GlassTink")
		end)

		it("keeps the normal range once the lesson is done", function()
			local victim, data, thief = setup({ TheftLessonDone = true })
			attempt(thief, victim, 1)
			local gap = (steal.TagRange + steal.LessonTagRange) / 2
			world:moveCharacter(victim, 1 + gap, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(false)
			expect(data.Board[1]):toBe("")
		end)

		it("rejects non numeric targets", function()
			local victim = setup()
			expect(world:invoke("TagThief", victim, "x")):toBe(false)
		end)
	end)

	describe("one steal per victim", function()
		local function enabledOf(owner: any, slot: number): any
			return prompt(owner, slot).Enabled
		end

		local function setupTwo()
			local victim, victimData, thief, thiefData = setup({ TheftLessonDone = true })
			local second = join("Cat", 400, { Board = S.board("OfficeTap") })
			world:spawnCharacter(second, 2, 3, 10)
			return victim, victimData, thief, thiefData, second
		end

		it("ignores a second thief's hold and rejects their trigger while the first holds", function()
			local victim, data, thief, _, second = setupTwo()
			prompt(victim, 1).PromptButtonHoldBegan:Fire(thief)
			prompt(victim, 2).PromptButtonHoldBegan:Fire(second)
			expect(#alertsTo(victim, 1)):toBe(1)
			prompt(victim, 2).Triggered:Fire(second)
			expect(data.Board[2]):toBe("PlainClack")
			local rejected = alertsTo(second, 9)
			expect(#rejected):toBe(1)
			expect(rejected[1][1]):toBe("Someone is already stealing from them!")
			prompt(victim, 1).Triggered:Fire(thief)
			expect(data.Board[1]):toBe("")
		end)

		it("disables the other prompts during a hold and re-enables them when it ends", function()
			local victim, _, thief = setupTwo()
			prompt(victim, 1).PromptButtonHoldBegan:Fire(thief)
			expect(enabledOf(victim, 2)):toBe(false)
			expect(enabledOf(victim, 1)):toBe(true)
			services.KeyboardService.BoardChanged:Fire(victim)
			expect(enabledOf(victim, 2)):toBe(false)
			prompt(victim, 1).PromptButtonHoldEnded:Fire(thief)
			expect(enabledOf(victim, 1)):toBe(true)
			expect(enabledOf(victim, 2)):toBe(true)
		end)

		it("lets another thief start after a hold ended without triggering", function()
			local victim, _, thief, _, second = setupTwo()
			prompt(victim, 1).PromptButtonHoldBegan:Fire(thief)
			prompt(victim, 1).PromptButtonHoldEnded:Fire(thief)
			prompt(victim, 2).PromptButtonHoldBegan:Fire(second)
			expect(#alertsTo(victim, 1)):toBe(2)
		end)

		it("keeps the prompts disabled for the whole carry", function()
			local victim, _, thief, _, second = setupTwo()
			attempt(thief, victim, 1)
			expect(enabledOf(victim, 2)):toBe(false)
			services.KeyboardService.BoardChanged:Fire(victim)
			expect(enabledOf(victim, 2)):toBe(false)
			prompt(victim, 2).PromptButtonHoldBegan:Fire(second)
			prompt(victim, 2).Triggered:Fire(second)
			expect(#alertsTo(victim, 1)):toBe(1)
			expect(alertsTo(second, 9)[1][1]):toBe(Steal.Reasons.Busy)
		end)

		it("re-enables the prompts after delivery", function()
			local victim, _, thief = setupTwo()
			attempt(thief, victim, 1)
			deliver(thief)
			expect(enabledOf(victim, 2)):toBe(true)
		end)

		it("re-enables the prompts after a tag", function()
			local victim, _, thief = setupTwo()
			attempt(thief, victim, 1)
			world:moveCharacter(victim, 3, 3, 10)
			expect(world:invoke("TagThief", victim, thief.UserId)):toBe(true)
			expect(enabledOf(victim, 1)):toBe(true)
			expect(enabledOf(victim, 2)):toBe(true)
		end)

		it("re-enables the prompts after the carry times out", function()
			local victim, _, thief = setupTwo()
			attempt(thief, victim, 1)
			world:advance(steal.CarryTimeoutSeconds + 1)
			expect(enabledOf(victim, 1)):toBe(true)
			expect(enabledOf(victim, 2)):toBe(true)
		end)

		it("re-enables the prompts when the carrier dies", function()
			local victim, _, thief = setupTwo()
			attempt(thief, victim, 1)
			world:killCharacter(thief)
			expect(enabledOf(victim, 2)):toBe(true)
		end)

		it("lets a second thief steal once the first carry ended", function()
			local victim, data, thief, _, second = setupTwo()
			attempt(thief, victim, 1)
			world:killCharacter(thief)
			attempt(second, victim, 2)
			expect(data.Board[2]):toBe("")
		end)

		it("allows concurrent steals from different victims", function()
			local victim, _, thief, _, second = setupTwo()
			local other = join("Dan", 600)
			world:spawnCharacter(other, 3, 3, 10)
			attempt(thief, victim, 1)
			world:moveCharacter(second, 601, 3, 10)
			local otherData = world.Data.Service:GetData(other)
			prompt(other, 1).PromptButtonHoldBegan:Fire(second)
			expect(enabledOf(other, 2)):toBe(false)
			expect(#alertsTo(other, 1)):toBe(1)
			prompt(other, 1).Triggered:Fire(second)
			expect(otherData.Board[1]):toBe("")
			expect(second.Character:GetAttribute("CarryingKey")):toBe("GlassTink")
			expect(thief.Character:GetAttribute("CarryingKey")):toBe("GlassTink")
		end)

		it("clears the mark when the holding thief leaves", function()
			local victim, _, thief, _, second = setupTwo()
			prompt(victim, 1).PromptButtonHoldBegan:Fire(thief)
			world:removePlayer(thief)
			expect(enabledOf(victim, 2)):toBe(true)
			prompt(victim, 2).PromptButtonHoldBegan:Fire(second)
			expect(#alertsTo(victim, 1)):toBe(2)
		end)

		it("clears the mark when the victim leaves", function()
			local victim, _, thief = setupTwo()
			prompt(victim, 1).PromptButtonHoldBegan:Fire(thief)
			world:removePlayer(victim)
			local rejoined = join("Vic", 0, { TheftLessonDone = true })
			world:spawnCharacter(rejoined, 0, 3, 0)
			world:moveCharacter(thief, 1, 3, 10)
			expect(enabledOf(rejoined, 2)):toBe(true)
		end)

		it("clears the mark when the victim leaves mid carry", function()
			local victim, _, thief = setupTwo()
			attempt(thief, victim, 1)
			world:removePlayer(victim)
			local rejoined = join("Vic", 0, { TheftLessonDone = true })
			expect(enabledOf(rejoined, 1)):toBe(true)
			expect(enabledOf(rejoined, 2)):toBe(true)
		end)
	end)

	describe("returning keys", function()
		it("returns the key after the carry timeout", function()
			local victim, data, thief = setup()
			attempt(thief, victim, 1)
			world:advance(steal.CarryTimeoutSeconds - 1)
			expect(data.Board[1]):toBe("")
			world:advance(2)
			expect(data.Board[1]):toBe("GlassTink")
			expect(world:walkSpeed(thief)):toBe(steal.NormalWalkSpeed)
			expect(#alertsTo(victim, 3)):toBe(1)
		end)

		it("returns the key when the thief leaves", function()
			local victim, data, thief = setup()
			attempt(thief, victim, 1)
			world:removePlayer(thief)
			expect(data.Board[1]):toBe("GlassTink")
			expect(#alertsTo(victim, 3)):toBe(1)
		end)

		it("returns the key when the thief dies", function()
			local victim, data, thief = setup()
			attempt(thief, victim, 1)
			world:killCharacter(thief)
			expect(data.Board[1]):toBe("GlassTink")
		end)

		it("returns the key when the thief resets", function()
			local victim, data, thief = setup()
			attempt(thief, victim, 1)
			world:resetCharacter(thief)
			expect(data.Board[1]):toBe("GlassTink")
		end)

		it("puts the key elsewhere when the original slot was refilled", function()
			local victim, data, thief = setup({ Inventory = { PlainClack = 1 } })
			attempt(thief, victim, 1)
			world:invoke("PlaceKey", victim, 1, "PlainClack")
			local totalsBefore = S.totals(data)
			world:advance(steal.CarryTimeoutSeconds + 1)
			expect(data.Board[1]):toBe("PlainClack")
			local totals = S.totals(data)
			expect(totals.GlassTink):toBe(1)
			expect(totals.PlainClack):toBe(totalsBefore.PlainClack)
			expect(table.find(data.Board, "GlassTink") ~= nil):toBe(true)
		end)

		it("sends the key to the inventory when the slot is taken and auto place is off", function()
			local victim, data, thief = setup({ Inventory = { PlainClack = 1 }, Settings = { AutoPlace = false } })
			attempt(thief, victim, 1)
			world:invoke("PlaceKey", victim, 1, "PlainClack")
			world:advance(steal.CarryTimeoutSeconds + 1)
			expect(data.Board[1]):toBe("PlainClack")
			expect(data.Inventory.GlassTink):toBe(1)
		end)

		it("does nothing when the victim has left", function()
			local victim, _, thief = setup()
			attempt(thief, victim, 1)
			world:removePlayer(victim)
			world:advance(steal.CarryTimeoutSeconds + 1)
			expect(thief.Character:GetAttribute("CarryingKey")):toBeNil()
			expect(world:walkSpeed(thief)):toBe(steal.NormalWalkSpeed)
		end)
	end)

	describe("shutdown", function()
		it("returns carried keys to their victims", function()
			local victim, victimData, thief, thiefData = setup()
			attempt(thief, victim, 1)
			expect(victimData.Board[1]):toBe("")
			services.StealService:Destroy()
			expect(victimData.Board[1]):toBe("GlassTink")
			expect(S.totals(thiefData).GlassTink):toBeNil()
			expect(world:walkSpeed(thief)):toBe(steal.NormalWalkSpeed)
		end)

		it("grants the key to nobody when the victim data is gone", function()
			local victim, victimData, thief, thiefData = setup()
			attempt(thief, victim, 1)
			world:removePlayer(victim)
			services.StealService:Destroy()
			expect(S.totals(thiefData).GlassTink):toBeNil()
			expect(S.totals(victimData).GlassTink):toBe(1)
		end)
	end)

	describe("playtime", function()
		it("accrues whole seconds on a timer", function()
			local _, data = join("Vic", 0, { PlaySeconds = 100 })
			world:advance(95)
			expect(data.PlaySeconds):toBeGreaterThan(160)
			expect(data.PlaySeconds):toBeLessThan(196)
		end)

		it("writes the remainder when the player leaves", function()
			local player, data = join("Vic", 0, { PlaySeconds = 100 })
			world:advance(47)
			world:removePlayer(player)
			expect(data.PlaySeconds):toBe(147)
		end)

		it("ends the shield during play", function()
			local victim, data, thief = setup({ PlaySeconds = steal.ShieldPlaySeconds - 40 })
			world:advance(30)
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("GlassTink")
			world:advance(30)
			attempt(thief, victim, 1)
			expect(data.Board[1]):toBe("")
		end)
	end)
	describe("board tags", function()
		it("tags a key added with a tag and clears the tag when the slot is cleared", function()
			local player, data = join("Vic", 0, { Board = S.board("PlainClack") })
			services.KeyboardService:AddKey(player, "GlassTink", "@Zed")
			expect(data.Board[2]):toBe("GlassTink")
			expect(data.BoardTags[2]):toBe("@Zed")
			expect(data.BoardTags[1]):toBe("")
			world:invoke("ClearSlot", player, 2)
			expect(data.BoardTags[2]):toBe("")
		end)

		it("clears the tag when another key is placed over it", function()
			local player, data = join("Vic", 0, { Board = S.board("PlainClack"), Inventory = { OfficeTap = 1 } })
			services.KeyboardService:AddKey(player, "GlassTink", "@Zed")
			world:invoke("PlaceKey", player, 2, "OfficeTap")
			expect(data.BoardTags[2]):toBe("")
		end)

		it("takes a key from a slot only when it matches", function()
			local player, data = join("Vic", 0, { Board = S.board("PlainClack") })
			expect(services.KeyboardService:TakeFromSlot(player, 1, "GlassTink")):toBe(false)
			expect(services.KeyboardService:TakeFromSlot(player, 1, "PlainClack")):toBe(true)
			expect(data.Board[1]):toBe("")
		end)

		it("restores a key to a free slot and falls back to AddKey otherwise", function()
			local player, data = join("Vic", 0, { Board = S.board("PlainClack") })
			expect(services.KeyboardService:RestoreKey(player, 5, "GlassTink")):toBe(true)
			expect(data.Board[5]):toBe("GlassTink")
			expect(services.KeyboardService:RestoreKey(player, 5, "TopazTap")):toBe(true)
			expect(table.find(data.Board, "TopazTap") ~= nil):toBe(true)
			expect(data.Board[5]):toBe("GlassTink")
		end)
	end)
end)
